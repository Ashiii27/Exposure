# Exposure — environment example.
#
# This repo runs on free tiers and needs no API keys for development.
# Real secrets are only needed from Phase 5 (live scans) and live in
# worker/.dev.vars (never committed) or GitHub Actions secrets.

# Shared secret used by the nightly GitHub Actions job to authenticate
# D1 ingest calls to the Worker (Phase 5+). Generate with:
#   openssl rand -hex 32
EXPOSURE_INGEST_SECRET=change-me
